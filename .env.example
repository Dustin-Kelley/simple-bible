# YouVersion Platform App Key.
# Create one at https://platform.youversion.com/ and copy this file to .env.local.
# Metro reads .env.local for local runs. Do not commit the real key.
# EAS builds read the same variable from the matching EAS environment
# (development, preview, or production). Use visibility "sensitive".
# "secret" is not inlined into the app.
EXPO_PUBLIC_YOUVERSION_APP_KEY=
